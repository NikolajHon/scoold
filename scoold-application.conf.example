# Vzorová konfigurácia pre lokálny vývoj – skopírujte do scoold-application.conf
#############  CORE  #############

scoold.app_name = "Platforma SOS – Komunita"
# scoold.para_access_key = "" (vygeneruje sa automaticky pri prvom štarte)
# scoold.para_secret_key = "" (vygeneruje sa automaticky pri prvom štarte)
scoold.para_endpoint = "http://para:8080"
scoold.host_url = "http://localhost:8000"
scoold.env = "development"
# scoold.app_secret_key = "" (vygeneruje sa automaticky pri prvom štarte)
scoold.admins = "Mykola.Honcharenko@posam.sk,admin@sos.local"
scoold.is_default_space_public = true
# lokálne heslá ponechané pre núdzový prístup správcu, bežne sa prihlasuje cez Keycloak
scoold.password_auth_enabled = true
# bez sprievodcu prvotným nastavením (konfigurácia je v tomto súbore)
scoold.onboarding_enabled = false

#############  CUSTOMIZATION  #############

scoold.default_language_code = "sk"

#############  MISCELLANEOUS  #############

scoold.autoinit.para_config_file = "/scoold/para-application.conf"

#############  KEYCLOAK (OpenID Connect)  #############

# prehliadač -> Keycloak (verejná adresa)
scoold.security.oauth.authz_url = "http://localhost:8081/realms/sos/protocol/openid-connect/auth"
# Para -> Keycloak (interná adresa v docker sieti)
scoold.security.oauth.token_url = "http://keycloak:8080/realms/sos/protocol/openid-connect/token"
scoold.security.oauth.profile_url = "http://keycloak:8080/realms/sos/protocol/openid-connect/userinfo"
scoold.oa2_app_id = "scoold"
scoold.oa2_secret = "scoold-dev-secret"  # len pre lokálny Keycloak
scoold.security.oauth.scope = "openid email profile"
scoold.security.oauth.parameters.id = "sub"
scoold.security.oauth.parameters.name = "name"
scoold.security.oauth.parameters.given_name = "given_name"
scoold.security.oauth.parameters.family_name = "family_name"
scoold.security.oauth.parameters.email = "email"
scoold.security.oauth.download_avatars = false
scoold.security.oauth.provider = "Prihlásiť sa cez Keycloak"
# Keycloak presmeruje prehliadač späť na Para (musí byť dostupná z prehliadača)
scoold.security.redirect_uri = "http://localhost:8080"
# po odhlásení zo Scooldu ukončiť aj reláciu v Keycloaku (inak sa používateľ prihlási znova bez hesla)
scoold.signout_url = "http://localhost:8081/realms/sos/protocol/openid-connect/logout?client_id=scoold&post_logout_redirect_uri=http%3A%2F%2Flocalhost%3A8000%2Fsignin%3Fcode%3D5%26success%3Dtrue"
# /signin rovno presmeruje na Keycloak (SSO bez ďalšieho kliknutia); po odhlásení (?code=5) nie
scoold.redirect_signin_to_idp = true

#############  SLOV-LEX  #############

# interná adresa slovlex-service (karty právnych predpisov)
scoold.slovlex_service_url = "http://slovlex:8090"

# Platforma SOS: roly zo skupín v Keycloaku (bez Scoold Pro), pozri KEYCLOAK.md
scoold.keycloak.role_sync_enabled = true
scoold.keycloak.url = "http://keycloak:8080"
scoold.keycloak.realm = "sos"
scoold.keycloak.admin_group = "sos-admin"
scoold.keycloak.mod_group = "sos-moderator"
scoold.keycloak.role_sync_interval_sec = 300
# jednotné odhlásenie (back-channel logout): issuer tokenov Keycloaku
scoold.keycloak.issuer = "http://localhost:8081/realms/sos"
# client_id / client_secret sa predvolene berú z oa2_app_id / oa2_secret

# Platforma SOS: odkaz "späť" do partnerskej aplikácie v hlavičke fóra
scoold.sos_portal_url = "http://localhost:8082"
scoold.sos_portal_name = "Agenda sociálnych služieb"
