## Nahrádza #infostrip – zachováva triedy infostrip/infostrip-content pre scoold.js (uvítacie správy)
#macro(idskinfostrip)
	#if ($request.getParameter("success"))
		#set($_bannerType = "govuk-notification-banner--success")
		#set($_bannerTitle = $!lang.get('idsk.success'))
	#elseif ($request.getParameter("error") || ($error && $error.size() > 0))
		#set($_bannerType = "govuk-notification-banner--error")
		#set($_bannerTitle = $!lang.get('idsk.error'))
	#else
		#set($_bannerType = "")
		#set($_bannerTitle = $!lang.get('idsk.info'))
	#end
	#if ($request.getParameter("code"))
		#set($infoStripMsg = $!lang.get("msgcode.${request.getParameter('code')}"))
		#if(!$infoStripMsg)#set($infoStripMsg = $!lang.get("${request.getParameter('code')}"))#end
	#else
		#set($infoStripMsg = $!error.get('error'))
	#end
	#if (!$infoStripMsg || $infoStripMsg.trim().isEmpty())#set($_bannerHide = "hide")#else#set($_bannerHide = "")#end
	<noscript>
		<div class="govuk-notification-banner govuk-notification-banner--warning" role="alert">
			<div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">$!{lang.get("nojavascript")}</p></div>
		</div>
	</noscript>
	<div class="govuk-notification-banner sos-banner infostrip $!{_bannerType} $!{_bannerHide}" role="region" aria-labelledby="sos-banner-title" data-module="govuk-notification-banner">
		<div class="govuk-notification-banner__header">
			<h2 class="govuk-notification-banner__title" id="sos-banner-title">$!_bannerTitle</h2>
		</div>
		<div class="govuk-notification-banner__content">
			<a href="#" class="close-infostrip" aria-label="$!lang.get('close')">&times;</a>
			#set($_infoStripMsg = $infoStripMsg)
			<p class="govuk-notification-banner__heading infostrip-content">$!_infoStripMsg</p>
		</div>
	</div>
#end

################# FORMULÁRE #####################
#macro(idskerror $text)
#if($text && !$text.isEmpty())
	<p class="govuk-error-message"><span class="govuk-visually-hidden">$!lang.get('idsk.error'):</span> $text</p>
#end
#end

#macro(idskspaceselect $post)
	#if($authUser.hasSpaces() || $isMod)
		#if($post)
			#set($_selSpace = $!scooldUtils.getSpaceId($!post.space))
		#else
			#set($_selSpace = $!scooldUtils.getSpaceId($!scooldUtils.getValidSpaceIdExcludingAll($authUser, "", $request)))
		#end
		<div class="govuk-form-group #if($error.get('space'))govuk-form-group--error#end">
			<label class="govuk-label govuk-body-m" for="sos-space-$!post.id">$!lang.get('idsk.space')</label>
			#idskerror($error.get("space"))
			<select class="govuk-select" id="sos-space-$!post.id" name="space">
				#if($scooldUtils.canAccessSpace($authUser, "default"))
					<option value="$scooldUtils.getDefaultSpace()" #if($scooldUtils.isDefaultSpace($_selSpace))selected#end>$!lang.get('defaultspace')</option>
				#end
				#foreach($space in $authUser.allSpaces)
				#if(!$scooldUtils.isDefaultSpace($space))
					<option value="$!space" #if($!scooldUtils.getSpaceId($space).equals($_selSpace))selected#end>$!scooldUtils.getSpaceName($space)</option>
				#end
				#end
			</select>
		</div>
	#end
#end

## Pole so štítkami – čipy z Materialize JS; skrytý input MUSÍ nasledovať hneď za .chips (scoold.js)
#macro(idsktagsinput $value $id)
	<div class="govuk-form-group #if($error.get('tags'))govuk-form-group--error#end">
		<label class="govuk-label govuk-body-m" for="$!{id}-input">$!lang.get('tags.title')
			<p class="govuk-body-s sos-muted sos-mb-0">$!lang.get('idsk.ask.tags.hint')</p>
		</label>
		#idskerror($error.get("tags"))
		<div class="chips chips-autocomplete" title="$!lang.get('tags.title')"></div><input type="hidden" name="tags" value="$!value" id="$!id">
	</div>
#end

################# ŠTÍTKY A STAVY #####################
#macro(idskstatus $post)
	#if($post.answerid && !$post.answerid.isEmpty())
		<span class="sos-status sos-status--success">$!lang.get('posts.answered')</span>
	#elseif(!$post.answercount || $post.answercount == 0)
		<span class="sos-status sos-status--neutral">$!lang.get('posts.unanswered')</span>
	#end
	#if($post.type == "unapprovedquestion" || $post.type == "unapprovedreply")
		<span class="sos-status sos-status--warning">$!lang.get('posts.unapproved')</span>
	#end
	#if($post.deprecated)
		<span class="sos-status sos-status--warning">$!lang.get('deprecated')</span>
	#end
	#if($post.isClosed())
		<span class="sos-status sos-status--neutral">$!lang.get('idsk.closed')</span>
	#end
#end

#macro(idsktags $post)
	#foreach($tagTxt in $post.tags)
		#if($tagTxt && $tagTxt.trim() != "")
			<a href="$questionslink/tag/$!utils.urlEncode($tagTxt)" class="sos-tag">$!tagTxt</a>
		#end
	#end
#end

#macro(idskperson $showu)
	#if($showu && ($scooldUtils.anonAuthUser.id == $showu.id || $scooldUtils.anonAuthUser.id.replaceAll(':profile$', '') == $showu.id))
		<span>$!lang.get('anonymous')</span>
	#elseif($showu && $showu.id)
		<a class="govuk-link" href="$profilelink/$!showu.id.replaceAll(':profile$', '')/#stripstr($!showu.name)">$!showu.name</a>
		#if($showu.groups == "admins")<span class="sos-status sos-status--neutral">$!lang.get('admin')</span>#end
		#if($showu.groups == "mods")<span class="sos-status sos-status--neutral">$!lang.get('mod')</span>#end
	#elseif($showu.name)
		<span>$!showu.name</span>
	#else
		<span>$!lang.get("profile.deleted")</span>
	#end
#end

################# ZOZNAM OTÁZOK #####################
#macro(idskquestionslist $posts)
	#set($_showSpace = $scooldUtils.isAllSpaces($currentSpace) || $isMod)
	<ul class="sos-list">
	#foreach($showpost in $posts)
		#set($_qlink = "#getpostlink($showpost false false)")
		#set($_acount = $showpost.answercount)
		#if(!$_acount)#set($_acount = 0)#end
		<li id="$!showpost.id" #if($showpost.id == $request.getParameter("deleted"))class="hide"#end>
			<article class="idsk-card">
				<div class="idsk-card__content">
					#if($_showSpace && !$scooldUtils.isDefaultSpace($showpost.space))
						<span class="sos-card-space">$!scooldUtils.getSpaceName($showpost.space)</span>
					#end
					<div class="idsk-card__heading">
						<h2 class="govuk-heading-s sos-mb-0"><a href="$!_qlink" class="govuk-link">$!showpost.title</a></h2>
					</div>
					#set($plainTxt = $utils.stripHtml($utils.markdownToHtml($utils.stripHtml($!showpost.body))))
					<div class="idsk-card__description">$!utils.abbreviate($plainTxt, 220)</div>
					<div class="sos-card-meta">
						#idskstatus($showpost)
						<span>$!lang.get('idsk.answercount'): <strong>$!_acount</strong></span>
						<span><time datetime="$!utils.formatDate($showpost.timestamp, 'yyyy-MM-dd', $currentLocale)">#formatdate($showpost.timestamp "")</time></span>
						#if(!$request.requestURI.startsWith("$!CONTEXT_PATH/profile"))
							<span>#idskperson($showpost.author)</span>
						#end
					</div>
					#if($showpost.tags && !$showpost.tags.isEmpty())
					<div>#idsktags($showpost)</div>
					#end
				</div>
			</article>
		</li>
	#end
	</ul>
#end

################# STRÁNKOVANIE #####################
## Klasické stránkovanie odkazmi (bez AJAX "Viac"), prístupné aj bez JS
#macro(idskpagination $pager $pageparam)
#if($pager && $pager.count > $pager.limit)
	#set($pgBase = "")#set($pgBase = $pgBase.concat($request.requestURI))#if($request.queryString)#set($pgBase = $pgBase.concat("?").concat($request.queryString))#end
	#set($_rexp = "${pageparam}=\d+&?")
	#set($pgBase = $pgBase.replaceAll($_rexp, ""))
	#set($pgBase = $pgBase.replaceAll("(&|\?)$", ""))
	#if($pgBase.contains("?"))#set($pgSep = "&")#else#set($pgSep = "?")#end
	#set($_pages = $pager.count / $pager.limit)
	#if($pager.count % $pager.limit > 0)#set($_pages = $_pages + 1)#end
	#if($_pages > $MAX_PAGES)#set($_pages = $MAX_PAGES)#end
	#set($_cur = $pager.page)
	#if($_cur < 1)#set($_cur = 1)#end
	#set($_from = $_cur - 2)
	#if($_from < 1)#set($_from = 1)#end
	#set($_to = $_cur + 2)
	#if($_to > $_pages)#set($_to = $_pages)#end
	<nav class="sos-pagination" aria-label="$!lang.get('idsk.pagination')">
		<ul>
			#if($_cur > 1)
				#set($_p = $_cur - 1)
				<li><a href="${pgBase}${pgSep}${pageparam}=$_p" rel="prev">&lsaquo; $!lang.get('idsk.prev')</a></li>
			#end
			#if($_from > 1)
				<li><a href="${pgBase}${pgSep}${pageparam}=1">1</a></li>
				#if($_from > 2)<li><span class="sos-pagination__gap">&hellip;</span></li>#end
			#end
			#foreach($_p in [$_from..$_to])
				#if($_p == $_cur)
					<li><span aria-current="page">$_p</span></li>
				#else
					<li><a href="${pgBase}${pgSep}${pageparam}=$_p">$_p</a></li>
				#end
			#end
			#if($_to < $_pages)
				#if($_to < $_pages - 1)<li><span class="sos-pagination__gap">&hellip;</span></li>#end
				<li><a href="${pgBase}${pgSep}${pageparam}=$_pages">$_pages</a></li>
			#end
			#if($_cur < $_pages)
				#set($_p = $_cur + 1)
				<li><a href="${pgBase}${pgSep}${pageparam}=$_p" rel="next">$!lang.get('idsk.next') &rsaquo;</a></li>
			#end
		</ul>
	</nav>
#end
#end

################# PRÍSPEVOK (otázka / odpoveď) #####################
#macro(idskpostbox $showpost $parentpost)
#set($actionlink = "#getpostlink($showpost false true)")
#if($showpost.id != $!utils.urlEncode($showpost.id))
	$showpost.setId($!utils.urlEncode($showpost.id))
#end
#if($request.getServletPath().endsWith("/edit-post-$!showpost.id"))#set($resumeEditPost = "resume-editing")#else#set($resumeEditPost = "")#end
#set($_isAccepted = $showpost.isReply() && $showpost.id.equals($parentpost.answerid))
<div id="$!showpost.id" class="postbox $!{showpost.type}box $!{resumeEditPost} sos-post #if($showpost.isReply())sos-post--answer#end #if($_isAccepted)sos-post--accepted#end #if($showpost.type == 'unapprovedreply')sos-post--unapproved#end">
	<div id="post-$!showpost.id" class="viewbox">
		#if($_isAccepted)
			<p class="sos-accepted-label govuk-body sos-mt-0">&#10003; $!lang.get('idsk.accepted')</p>
		#end
		<div class="postbody">
			#set($_bodyHtml = $utils.markdownToHtml($!showpost.body, $!htmlInMarkdownEnabled))
			$!{_bodyHtml}
		</div>

		<div class="sos-post-meta">
			<span>#idskperson($showpost.author)</span>
			<span>$!lang.get("posts.posted") #formatdate($showpost.timestamp "")</span>
			#if($showpost.lasteditby)
				#if($showpost.revisionid)
					<a class="govuk-link" href="$revisionslink/$!showpost.id">$!lang.get("posts.edited") #formatdate($showpost.lastedited "")</a>
				#else
					<span>$!lang.get("posts.edited") #formatdate($showpost.lastedited "")</span>
				#end
			#end
			#if($showpost.type == "unapprovedreply")<span class="sos-status sos-status--warning">$!lang.get('posts.unapproved')</span>#end
		</div>

		<div class="sos-post-actions" aria-label="$!lang.get('idsk.actions')">
			#if($authenticated && $showpost.isReply() && $scooldUtils.canApproveReply($parentpost, $authUser))
				<a href="$questionlink/$!parentpost.id/approve/$!showpost.id" class="govuk-link approve-answer #if($_isAccepted)green-text#end">$!lang.get('idsk.markaccepted')</a>
			#end
			#if($scooldUtils.isMod($authUser) && ($showpost.type == "unapprovedreply" || $showpost.type == "unapprovedquestion"))
				<a href="$!actionlink/$showpost.id/approve" class="govuk-link post-refresh">$!lang.get("posts.approve")</a>
			#end
			#if($scooldUtils.canEdit($showpost, $authUser))
				<a href="#" class="govuk-link editlink">$!lang.get("edit")</a>
			#end
			#if($canComment && !$showpost.isFeedback())
				<a href="#" class="govuk-link next-div-toggle add-comment-link" aria-controls="sos-comment-$!showpost.id">$!lang.get("comments.write")</a>
			#end
			#if($authenticated && $showpost.isQuestion())
				<a href="#post-$!showpost.id" class="govuk-link follow-thread-bell">$!lang.get('posts.emailme')</a>
			#end
			#if($scooldUtils.isMod($authUser) && $showpost.isQuestion())
				#if($parentpost.isClosed())
					<a href="$!actionlink/$showpost.id/close" class="govuk-link post-refresh">$!lang.get("reopen")</a>
				#else
					<a href="$!actionlink/$showpost.id/close" class="govuk-link post-refresh-ask">$!lang.get("close")</a>
				#end
				#if($parentpost.deprecated)
					<a href="$!actionlink/$showpost.id/deprecate" class="govuk-link post-refresh-ask">$!lang.get("undeprecate")</a>
				#else
					<a href="$!actionlink/$showpost.id/deprecate" class="govuk-link post-refresh-ask">$!lang.get("deprecate")</a>
				#end
			#end
			#if(!$authenticated || ($authenticated && $showpost.creatorid != $authUser.id))
				#set($_rlink = "$questionlink/$!showpost.id")
				#set($_rhref = "$reportslink/form?parentid=$!showpost.id&type=$!showpost.type&link=$utils.urlEncode($_rlink)")
				<a href="#main-modal" data-fetch="$!{_rhref}" class="govuk-link modal-trigger">$!lang.get('report')</a>
			#end
			#if($scooldUtils.canDelete($showpost, $authUser, $parentpost.answerid) || $scooldUtils.isMod($authUser))
				<a href="$!actionlink/$showpost.id/delete" class="govuk-link delete-post">$!lang.get("delete")</a>
			#end
		</div>

		## Formulár komentára musí byť PRVÝ div hneď za .sos-post-actions – scoold.js (a.next-div-toggle)
		## prepína "hide" na najbližšom nasledujúcom div-e rodiča odkazu "Pridať komentár".
		#if($canComment)
			#idskcommentform($showpost.id)
		#end
		<div class="comments post-comments">
			<div class="page-content">
				#foreach($_c in $showpost.comments)
					#idskcommentbox($_c)
				#end
			</div>
		</div>
	</div>

	#if($scooldUtils.canEdit($showpost, $authUser))
	<div class="editbox hide">
		<form method="post" action="$questionlink/$!showpost.id/edit" class="edit-post-form">
			#if(!$showpost.isReply())
				<div class="govuk-form-group">
					<label class="govuk-label govuk-body-m" for="edit-$!{showpost.id}-title">$!lang.get('posts.title')</label>
					<input class="govuk-input" type="text" name="title" maxlength="255" minlength="2" value="$!showpost.title" id="edit-$!{showpost.id}-title" required>
				</div>
			#end
			<div class="govuk-form-group emoji-picker-container">
				<label class="govuk-label govuk-body-m" for="edit-$!{showpost.id}-body">$!lang.get('idsk.ask.body')</label>
				<textarea class="edit-post" name="body" maxlength="$MAX_TEXT_LENGTH" minlength="10" id="edit-$!{showpost.id}-body">$!showpost.body</textarea>
			</div>
			#if(!$showpost.isReply())
				#idsktagsinput($!showpost.tagsString "edit-$!{showpost.id}-tags")
				#idskspaceselect($showpost)
			#end
			<div class="sos-form-actions">
				<button class="govuk-button govuk-button__basic" type="submit" data-module="govuk-button">$!lang.get('save')</button>
				<button type="button" class="govuk-button govuk-button--sec canceledit">$!lang.get('cancel')</button>
			</div>
		</form>
	</div>
	#end
</div>
#end

#macro(idskanswers $answers $parentpost)
	#foreach($answer in $answers)
		#idskpostbox($answer $parentpost)
	#end
#end

################# KOMENTÁRE #####################
## Bez hlasovania; triedy commentbox, comment-text, delete-comment sú pre scoold.js
#macro(idskcommentbox $showcomment)
<div class="commentbox" id="comment-$!showcomment.id">
	#if($showcomment.hidden)
		<span class="sos-muted">$!lang.get("comments.hidden")</span>
		<a href="#" class="govuk-link show-comment">$!lang.get("comments.show")</a>
	#end
	<div class="comment-text #if($showcomment.hidden)hide#end">
		#set($_commentHtml = $utils.markdownToHtml($!showcomment.comment))
		$!{_commentHtml}
		#set($_cAuthor = {'name': $!showcomment.authorName, 'id': $showcomment.creatorid})
		&mdash; <span class="comment-author">#idskperson($_cAuthor)</span>,
		<span class="comment-meta">#formatdate($showcomment.timestamp '')</span>
		#if($authenticated && ($showcomment.creatorid == $authUser.id || $scooldUtils.isMod($authUser)))
			<a href="$commentlink/$!showcomment.id/delete" class="govuk-link delete-comment">$!lang.get('delete')</a>
		#end
	</div>
</div>
#end

#macro(idskcommentform $parentid)
#set($_maxplus1 = $!maxCommentLength + 1)
<div class="newcommentform hide" id="sos-comment-$!parentid">
	<form method="post" action="$commentlink" class="new-comment-form">
		<div class="govuk-form-group">
			<label class="govuk-label govuk-body-s" for="new-comment-$!{parentid}">$!lang.get('comment.title')
				<span class="sos-muted">($!lang.get('comments.markdown'))</span></label>
			<input class="govuk-input" id="new-comment-$!{parentid}" type="text" name="comment" maxlength="$!_maxplus1" required>
		</div>
		<input type="hidden" name="parentid" value="$!parentid">
		<button type="submit" class="govuk-button govuk-button--sec new-comment-btn">$!lang.get('add')</button>
	</form>
</div>
#end
