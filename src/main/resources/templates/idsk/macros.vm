## =====================================================================
##  Platforma SOS – Velocity makrá pre ID-SK 3.0 layout
##  Registrované ako knižnica v ScooldServer (VM_LIBRARY = macro.vm,idsk/macros.vm).
##  Všetky makrá majú prefix "idsk", aby nekolidovali s pôvodnými makrami Scooldu.
##  Triedy ako editlink, viewbox, editbox, delete-post, post-refresh, approve-answer
##  sú zachované zámerne – viaže sa na ne správanie v scoold.js.
## =====================================================================

################# HLAVIČKA #####################
#macro(idskheader)
<div class="govuk-header__wrapper">
	<header class="govuk-header idsk-shadow-head" data-module="govuk-header">
		<div class="govuk-header__container">
			<div class="idsk-secondary-navigation govuk-width-container">
				<div class="idsk-secondary-navigation__header">
					<div class="idsk-secondary-navigation__heading">
						<div class="idsk-secondary-navigation__heading-title">
							<span class="idsk-secondary-navigation__heading-mobile">SK</span>
							<span class="idsk-secondary-navigation__heading-desktop">$!lang.get('idsk.official')</span>
							<button type="button" class="govuk-button govuk-button--texted--inverse idsk-secondary-navigation__heading-button" aria-expanded="false" aria-label="$!lang.get('idsk.official') $!lang.get('idsk.official.gov')">
								<span class="idsk-secondary-navigation__heading-mobile">e-Gov</span>
								<span class="idsk-secondary-navigation__heading-desktop"><b>$!lang.get('idsk.official.gov')</b></span>
								<span class="material-icons" aria-hidden="true">arrow_drop_down</span>
							</button>
						</div>
						<div class="idsk-secondary-navigation__body hidden">
							<div class="idsk-secondary-navigation__text">
								<div>
									<h3 class="govuk-body-s"><b>$!lang.get('idsk.official.domain.title')</b></h3>
									<p class="govuk-body-s">$!lang.get('idsk.official.domain.text')</p>
								</div>
								<div>
									<h3 class="govuk-body-s"><b>$!lang.get('idsk.official.secure.title')</b></h3>
									<p class="govuk-body-s">$!lang.get('idsk.official.secure.text')</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="govuk-predheader govuk-width-container">
			<div class="govuk-header__logo">
				<a href="$!{CONTEXT_PATH}/" class="govuk-header__link govuk-header__link--homepage sos-logo-text" title="$!lang.get('idsk.home')">
					<img src="$!imageslink/idsk/sos-logo.svg?r=$!rev" alt="$!APPNAME – $!lang.get('idsk.home')"/>
				</a>
			</div>
			<div class="govuk-header__btns-search">
				<div class="govuk-header__mobile-menu desktop-hidden">
					<button type="button" class="govuk-header__menu-button font-bold govuk-js-header-toggle" aria-controls="navigation" hidden>
						$!lang.get('idsk.menu')
					</button>
				</div>

				<form class="idsk-searchbar__wrapper" role="search" action="$searchlink" method="get">
					<label for="sos-header-search" class="govuk-visually-hidden">$!lang.get('idsk.search.placeholder')</label>
					<input id="sos-header-search" class="govuk-input" type="search" name="q" value="$!searchQuery"
								 placeholder="$!lang.get('idsk.search.placeholder')" required/>
					<button type="submit" class="govuk-button govuk-button__basic" aria-label="$!lang.get('search.search')">
						<span class="material-icons" aria-hidden="true">search</span>
					</button>
				</form>

				<div class="govuk-header__actionPanel desktop mobile-hidden sos-user-panel">
					#if($sosPortalUrl && !$sosPortalUrl.isEmpty())
						<a id="sos-back-link" href="$!sosPortalUrl/" data-portal="$!sosPortalUrl"
							 class="govuk-button govuk-button--sec sos-back-btn" title="$!utils.stripHtml($sosPortalName)">
							<span class="material-icons" aria-hidden="true">arrow_back</span> $!utils.stripHtml($sosPortalName)</a>
					#end
					#if($authenticated)
						<button type="button" class="govuk-button govuk-header__profile_button" title="$!lang.get('idsk.profile')" aria-haspopup="dialog">$!idskInitials</button>
					#else
						<a href="${signinlink}?returnto=$!{returnto}" class="govuk-button govuk-button__basic sos-signin-btn" role="button">$!lang.get('signin.title')</a>
					#end
				</div>
			</div>
		</div>

		<nav id="navigation" aria-label="$!lang.get('idsk.menu')" class="govuk-header__navigation govuk-width-container">
			#if($authenticated)
			<dialog id="navigationProfileDialog" aria-label="$!lang.get('idsk.profile')">
				<div class="govuk-header__profile">
					<div class="govuk-header__profile__header mobile-hidden">
						<div class="govuk-heading-m">$!lang.get('profile.title')</div>
						<button type="button" class="govuk-button govuk-button--texted govuk-header__profile_close_button" aria-label="$!lang.get('close')"><span class="material-icons" aria-hidden="true">close</span></button>
					</div>
					<div class="govuk-header__profile__body">
						<img class="profile sos-profile-avatar" src="#profilepic($authUser, 'Square127')" alt="" width="96" height="96"/>
						<h4 class="govuk-heading-l">$!authUser.name</h4>
						<a href="$profilelink" class="govuk-button govuk-button__basic" role="button">$!lang.get('idsk.profile')</a>
						<a href="$settingslink" class="govuk-button govuk-button--sec" role="button">$!lang.get('settings.title')</a>
						#if($isAdmin)
						<a href="$adminlink" class="govuk-button govuk-button--sec" role="button">$!lang.get('administration.title')</a>
						#end
						## Odhlásenie: POST na /signout (ukončí reláciu Scooldu) a potom prechod na scoold.signout_url
						## (odhlásenie aj z Keycloaku). Rieši to skript v layout.vm – priame presmerovanie z formulára
						## na inú doménu by zablokovala CSP (form-action 'self').
						<form method="post" action="$signoutlink" class="sos-signout-form" data-logout-url="$!scooldUtils.config.signoutUrl()">
							<button type="submit" class="govuk-button govuk-button--texted govuk-button--texted__warning">$!lang.get('signout')</button>
						</form>
					</div>
				</div>
			</dialog>
			#end
			<span class="text">$!lang.get('idsk.menu')</span>
			<div class="govuk-header__navigation-list">
				<ul>
					#idsknavitem($questionslink $lang.get('questions.title') $questionsSelected)
					#idsknavitem("$questionslink/ask" $lang.get('posts.ask') $askSelected)
					#idsknavitem($tagslink $lang.get('tags.title') $tagsSelected)
					#if($scooldUtils.config.usersDiscoverabilityEnabled($isAdmin))
						#idsknavitem($peoplelink $lang.get('people.title') $peopleSelected)
					#end
					#if($authenticated && $isMod)
					<li class="govuk-header__navigation-item #if($reportsSelected)govuk-header__navigation-item--active#end" #if($reportsSelected)aria-current="page"#end>
						<a class="govuk-header__link" href="$reportslink">$!lang.get('reports.title')
							#if($authUser.countNewReports() > 0)<span class="sos-count">$authUser.countNewReports()</span>#end
						</a>
					</li>
					#end
					#if($authenticated && ($authUser.hasSpaces() || $isMod))
						#idskspacesdropdown()
					#end
					#if(!$authenticated)
					<li class="govuk-header__navigation-item desktop-hidden">
						<a class="govuk-header__link" href="${signinlink}?returnto=$!{returnto}">$!lang.get('signin.title')</a>
					</li>
					#end
				</ul>
			</div>
		</nav>
	</header>
</div>
#end

## Hlavička bez navigácie (onboarding, $hidenav)
#macro(idskheaderminimal)
<div class="govuk-header__wrapper">
	<header class="govuk-header idsk-shadow-head" data-module="govuk-header">
		<div class="govuk-predheader govuk-width-container">
			<div class="govuk-header__logo">
				<a href="$!{CONTEXT_PATH}/" class="govuk-header__link govuk-header__link--homepage sos-logo-text" title="$!lang.get('idsk.home')">
					<img src="$!imageslink/idsk/sos-logo.svg?r=$!rev" alt="$!APPNAME"/>
				</a>
			</div>
		</div>
	</header>
</div>
#end

#macro(idsknavitem $href $text $selected)
<li class="govuk-header__navigation-item #if($selected && !$selected.isEmpty())govuk-header__navigation-item--active#end" #if($selected && !$selected.isEmpty())aria-current="page"#end>
	<a class="govuk-header__link" href="$href">$text</a>
</li>
#end

#macro(idskspacesdropdown)
	#if($currentSpace.isEmpty() || $scooldUtils.isDefaultSpace($currentSpace))
		#set($spaceLabelTxt = $!lang.get('defaultspace'))
	#elseif($scooldUtils.isAllSpaces($currentSpace))
		#set($spaceLabelTxt = $!lang.get('allspaces'))
	#else
		#set($spaceLabelTxt = $utils.abbreviate($scooldUtils.getSpaceName($currentSpace), 30))
	#end
	<li class="govuk-header__navigation-item">
		<div class="idsk-dropdown__wrapper" data-pseudolabel="$!lang.get('spaces.title')">
			<a role="button" href="#" class="govuk-button govuk-button--texted idsk-dropdown" aria-label="$!lang.get('spaces.title'): $!spaceLabelTxt" aria-haspopup="listbox">
				<span>$!lang.get('idsk.space'): $!spaceLabelTxt</span>
				<span class="material-icons" aria-hidden="true">keyboard_arrow_down</span>
			</a>
			<ul class="idsk-dropdown__options idsk-shadow-medium">
				#if($authUser.hasSpaces())
				<li class="idsk-dropdown__option idsk-pseudolabel__wrapper #if($scooldUtils.isAllSpaces($currentSpace))active#end" data-pseudolabel="$!lang.get('allspaces')">
					<a href="$questionslink/space/all?returnto=$!returnto">$!lang.get('allspaces')</a>
				</li>
				#end
				#if($scooldUtils.canAccessSpace($authUser, "default"))
				<li class="idsk-dropdown__option idsk-pseudolabel__wrapper #if($currentSpace.isEmpty() || $scooldUtils.isDefaultSpace($currentSpace))active#end" data-pseudolabel="$!lang.get('defaultspace')">
					<a href="$questionslink/space?returnto=$!returnto">$!lang.get('defaultspace')</a>
				</li>
				#end
				#foreach($space in $authUser.allSpaces)
				#if(!$scooldUtils.isDefaultSpace($space))
					#set($spaceNameTxt = $scooldUtils.getSpaceName($space))
					<li class="idsk-dropdown__option idsk-pseudolabel__wrapper #if($!currentSpace == $space)active#end" data-pseudolabel="$!spaceNameTxt">
						<a href="$questionslink/space/$!scooldUtils.getSpaceId($!space)?returnto=$!returnto">$!utils.abbreviate($!spaceNameTxt, 40)</a>
					</li>
				#end
				#end
			</ul>
		</div>
	</li>
#end

################# PÄTA #####################
#macro(idskfooter)
<footer class="govuk-footer" role="contentinfo">
	<div class="govuk-width-container">
		<div class="govuk-footer__meta">
			<div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
				<h2 class="govuk-visually-hidden">$!lang.get('idsk.details')</h2>
				<ul class="govuk-footer__inline-list">
					<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="$aboutlink">$!lang.get('about.title')</a></li>
					#if($scooldUtils.isFeedbackEnabled())
					<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="$feedbacklink">$!lang.get('feedback.title')</a></li>
					#end
					<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="$privacylink">$!lang.get('privacy.title')</a></li>
					<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="$termslink">$!lang.get('terms.title')</a></li>
					<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="$aboutlink#accessibility">$!lang.get('idsk.accessibility')</a></li>
					<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="$!{CONTEXT_PATH}/feed.xml">RSS</a></li>
					<li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="$!languageslink">$!lang.get('idsk.language'): $!currentLocale.getDisplayLanguage($currentLocale)</a></li>
				</ul>
				#set($_footerHTML = $!scooldUtils.getFooterHTML())
				#if($_footerHTML && !$_footerHTML.isEmpty())<div class="govuk-body-s">$!_footerHTML</div>#end
				<span class="govuk-footer__licence-description">
					$!lang.get('idsk.operator')
					<br/>
					$!lang.get('idsk.manual')
				</span>
			</div>
			<div class="govuk-footer__meta-item">
				<a class="govuk-footer__link govuk-footer__copyright-logo" href="$!{CONTEXT_PATH}/">
					<img src="$!imageslink/idsk/sos-logo.svg?r=$!rev" alt="$!APPNAME"/>
				</a>
			</div>
		</div>
	</div>
</footer>
#end

