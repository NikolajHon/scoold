## Platforma SOS – spätná väzba k platforme (ID-SK): zoznam, nový príspevok, detail s odpoveďami
## Bez hlasovania. form#write-feedback-form a form#answer-question-form používa scoold.js (EasyMDE, koncept v localStorage).
#if ($write)
	<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
		<ol class="govuk-breadcrumbs__list">
			<li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="$feedbacklink">$!lang.get('feedback.title')</a></li>
		</ol>
	</nav>
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds-from-desktop">
			<h1 class="govuk-heading-xl">$!lang.get("feedback.write")</h1>
			<p class="govuk-body-l">$!lang.get('idsk.feedback.write.lead')</p>

			<form method="post" action="$feedbacklink" id="write-feedback-form">
				#sectoken(false "CREATE_FEEDBACK")
				<div class="govuk-form-group #if($error.get('title'))govuk-form-group--error#end">
					<label class="govuk-label govuk-body-m" for="title_text">$!lang.get('posts.title')
						<span class="idsk-required">*</span>
					</label>
					#idskerror($error.get("title"))
					<input class="govuk-input #if($error.get('title'))govuk-input--error#end" type="text" id="title_text" name="title" maxlength="255" minlength="2" required>
				</div>

				<div class="govuk-form-group emoji-picker-container #if($error.get('body'))govuk-form-group--error#end">
					<label class="govuk-label govuk-body-m" for="body_text">$!lang.get('idsk.feedback.body')
						<span class="idsk-required">*</span>
						<p class="govuk-body-s sos-muted sos-mb-0">$!lang.get('idsk.ask.body.hint')</p>
					</label>
					#idskerror($error.get("body"))
					<textarea class="edit-post" id="body_text" name="body" maxlength="$MAX_TEXT_LENGTH" minlength="10"></textarea>
				</div>

				#idsktagsinput("" "feedback-tags")

				<div class="sos-form-actions">
					<button class="govuk-button govuk-button__basic submit-spinner" type="submit" data-module="govuk-button">$!lang.get('send')</button>
					<a href="$feedbacklink" class="govuk-link">$!lang.get('cancel')</a>
				</div>
			</form>
		</div>
	</div>
#elseif ($showPost)
	<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
		<ol class="govuk-breadcrumbs__list">
			<li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="$feedbacklink">$!lang.get('feedback.title')</a></li>
		</ol>
	</nav>

	<div class="govuk-grid-row questionpage">
		<div class="govuk-grid-column-two-thirds-from-desktop">
			#if($showPost.isClosed())<div><span class="sos-status sos-status--neutral">$!lang.get('idsk.closed')</span></div>#end
			<h1 class="govuk-heading-xl" id="post-title">$!{showPost.title}</h1>

			#ajaxloading(true)
			#idskpostbox($showPost $showPost)

			<div class="answers-head">
				<h2 class="govuk-heading-l">$!lang.get("idsk.feedback.replies") ($!itemcount.count)</h2>
				#if ($answerslist && !$answerslist.isEmpty())
					#set($_sortby = "")#if($request.getParameter('sortby'))#set($_sortby = $request.getParameter('sortby'))#end
					<ul class="sos-tabs">
						<li><a href="$!showPost.getPostLinkForRedirect()" #if($_sortby != "newest")aria-current="page"#end>$!lang.get("idsk.sort.recommended")</a></li>
						<li><a href="$!showPost.getPostLinkForRedirect()?sortby=newest" #if($_sortby == "newest")aria-current="page"#end>$!lang.get("newest")</a></li>
					</ul>
				#else
					<p class="govuk-body sos-muted">$!lang.get('idsk.feedback.noreplies')</p>
				#end
			</div>

			<div class="sos-answers">
				#idskanswers($answerslist $showPost)
			</div>
			#idskpagination($itemcount "page")

			#if ($authenticated && !$showPost.isClosed())
				<form method="post" id="answer-question-form">
					#sectoken(false "CREATE_REPLY")
					<a id="write-post"></a>
					<div class="govuk-form-group emoji-picker-container #if($error.get('body'))govuk-form-group--error#end">
						<h2 class="govuk-label-wrapper">
							<label class="govuk-label govuk-label--m" for="answer_body">$!lang.get("feedback.writereply")</label>
						</h2>
						#idskerror($error.get("body"))
						<textarea class="edit-post" id="answer_body" name="body" maxlength="$MAX_TEXT_LENGTH" minlength="10"></textarea>
					</div>
					<input type="hidden" name="answer" value="true">
					<button class="govuk-button govuk-button__basic submit-spinner" type="submit" data-module="govuk-button">$!lang.get('post')</button>
				</form>
			#elseif (!$authenticated)
				<a href="$signinlink?returnto=$!returnto" rel="nofollow" class="govuk-button govuk-button__basic" role="button">$!lang.get("feedback.writereply")</a>
			#else
				<div class="govuk-notification-banner" role="region" aria-labelledby="sos-closed-title">
					<div class="govuk-notification-banner__header">
						<h2 class="govuk-notification-banner__title" id="sos-closed-title">$!lang.get('idsk.closed')</h2>
					</div>
					<div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">$!lang.get("idsk.feedback.closed")</p></div>
				</div>
			#end
		</div>

		<aside class="govuk-grid-column-one-third-from-desktop" aria-label="$!lang.get('idsk.details')">
			<div class="sos-aside">
				<h2 class="govuk-heading-s">$!lang.get('idsk.details')</h2>
				<dl class="govuk-body">
					<dt>$!lang.get('idsk.author')</dt>
					<dd>#idskperson($showPost.author)</dd>
					<dt>$!lang.get('posts.posted')</dt>
					<dd>#formatdate($showPost.timestamp "dd. MM. yyyy, HH:mm")</dd>
					#if($showPost.updated)
					<dt>$!lang.get('posts.updated')</dt>
					<dd>#formatdate($showPost.updated "")</dd>
					#end
					<dt>$!lang.get('idsk.feedback.replies')</dt>
					<dd>$!showPost.answercount</dd>
					<dt>$!lang.get('posts.views')</dt>
					<dd>$!utils.abbreviateInt($!showPost.viewcount, 0)</dd>
					#if($showPost.location && !$showPost.location.isEmpty())
					<dt>$!lang.get('profile.about.location')</dt>
					<dd>$!showPost.location</dd>
					#end
					#if ($showPost.tags && !$showPost.tags.isEmpty() && !$showPost.tags.get(0).isEmpty())
					<dt>$!lang.get('tags.title')</dt>
					<dd class="tags-aside">#idskfeedbacktags($showPost)</dd>
					#end
				</dl>
			</div>
		</aside>
	</div>
#else
	#set($_sortby = "")#if($request.getParameter('sortby'))#set($_sortby = $request.getParameter('sortby'))#end
	#set($fbBase = $feedbacklink)
	#if($tag)#set($fbBase = $feedbacklink.concat("/tag/").concat($utils.urlEncode($tag)))#end

	#if($tag)
	<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
		<ol class="govuk-breadcrumbs__list">
			<li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="$feedbacklink">$!lang.get('feedback.title')</a></li>
			<li class="govuk-breadcrumbs__list-item" aria-current="page">$!tag</li>
		</ol>
	</nav>
	#end

	<div class="sos-page-head">
		<div>
			<h1 class="govuk-heading-xl sos-mb-0">
				#if($tag)$!lang.get("feedback.tagged") „$!tag“#else$!lang.get("feedback.title")#end
			</h1>
			#if($itemcount.count > 0)<p class="govuk-body sos-muted">$!lang.get('results'): $!itemcount.count</p>#end
		</div>
		<a href="$feedbacklink/write" class="govuk-button govuk-button__basic" role="button">$!lang.get('feedback.write')</a>
	</div>

	<p class="govuk-body-l">$!lang.get('idsk.feedback.lead')</p>

	#if(!$tag)
	<nav aria-label="$!lang.get('idsk.sort')">
		<ul class="sos-tabs">
			<li><a href="$fbBase" #if($_sortby != "updated")aria-current="page"#end>$!lang.get("newest")</a></li>
			<li><a href="${fbBase}?sortby=updated" #if($_sortby == "updated")aria-current="page"#end>$!lang.get("posts.updated")</a></li>
		</ul>
	</nav>
	#end

	#if(!$feedbacklist || $feedbacklist.isEmpty())
		<div class="sos-empty">
			<p class="govuk-body-l sos-mb-0">$!lang.get("search.notfound")</p>
		</div>
	#else
		#idskfeedbacklist($feedbacklist)
		#idskpagination($itemcount "page")
	#end
#end
