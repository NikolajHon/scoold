{
  "realm": "sos",
  "enabled": true,
  "displayName": "Platforma SOS",
  "internationalizationEnabled": true,
  "supportedLocales": ["sk", "en"],
  "defaultLocale": "sk",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "groups": [
    { "name": "sos-admin" },
    { "name": "sos-moderator" },
    { "name": "obce" },
    { "name": "poskytovatelia" },
    { "name": "rezort" }
  ],
  "clients": [
    {
      "clientId": "scoold",
      "name": "Scoold – komunitný kanál",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "scoold-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/oauth2_auth*"],
      "webOrigins": ["http://localhost:8000"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:8000/*" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.sos", "email": "admin@sos.local", "firstName": "Admin", "lastName": "SOS",
      "enabled": true, "emailVerified": true, "groups": ["sos-admin"],
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }]
    },
    {
      "username": "obec.test", "email": "obec@sos.local", "firstName": "Jana", "lastName": "Obecná",
      "enabled": true, "emailVerified": true, "groups": ["obce"],
      "credentials": [{ "type": "password", "value": "test", "temporary": false }]
    },
    {
      "username": "poskytovatel.test", "email": "poskytovatel@sos.local", "firstName": "Peter", "lastName": "Poskytovateľ",
      "enabled": true, "emailVerified": true, "groups": ["poskytovatelia"],
      "credentials": [{ "type": "password", "value": "test", "temporary": false }]
    },
    {
      "username": "rezort.test", "email": "rezort@sos.local", "firstName": "Mária", "lastName": "Rezortná",
      "enabled": true, "emailVerified": true, "groups": ["rezort", "sos-moderator"],
      "credentials": [{ "type": "password", "value": "test", "temporary": false }]
    }
  ]
}
